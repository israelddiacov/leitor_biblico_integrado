*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ambientes Virtuais
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs e Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos Brutos e Pastas Não Utilizadas no Runtime
bible_databases-master/
scratch/
scratch_*.py
*.tmp
*.bak
*.log
.system_generated/

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Configurações Streamlit locais
.streamlit/secrets.toml

# Banco de dados central (>100MB bloqueado pelo GitHub)
# O repositório armazena biblia.db.zip (38MB) que é descompactado automaticamente no runtime.
biblia.db
!biblia.db.zip

__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env*
